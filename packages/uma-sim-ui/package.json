{
  "name": "uma-sim-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-only",
  "description": "Browser UI for uma-sim career simulator",
  "scripts": {
    "test": "node --test tests/branch-input.test.mjs tests/branch-trace-panel.test.mjs test/log-view.test.mjs test/log-export.test.mjs test/skills-view.test.mjs tests/run-setup-file.test.mjs",
    "test:browser": "node tests/receiving/uma-lab-receiver.mjs dist test-results/career-lab",
    "test:trace": "node tests/receiving/uma-trace-receiver.mjs dist test-results/trace",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "1.62.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
