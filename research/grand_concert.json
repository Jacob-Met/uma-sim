  "hard_caps": { "speed": 1600, "stamina": 1300, "power": 1300, "guts": 1500, "wit": 1300 },
  "soft_cap": 1200,
  "soft_cap_rule": "Stat gains above soft_cap are halved; in-race stat effect above soft_cap is roughly halved (Global July 2026).",
  "spark": { "speed": true, "guts": true },
  "fan_target_optional_race": 4500,

  "performance_types": [
    { "packet_type": 1, "api_key": "dance", "display": "Dance", "bot_label": "Da", "sim_key": "perf_Da" },
    { "packet_type": 2, "api_key": "passion", "display": "Passion", "bot_label": "Pa", "sim_key": "perf_Pa" },
    { "packet_type": 3, "api_key": "vocal", "display": "Vocal", "bot_label": "Vo", "sim_key": "perf_Vo" },
    { "packet_type": 4, "api_key": "visual", "display": "Visual", "bot_label": "Vi", "sim_key": "perf_Vi" },
    { "packet_type": 5, "api_key": "composure", "display": "Composure", "bot_label": "Co", "sim_key": "perf_Me" }
  ],
  "performance_max": 200,

  "training_performance_gains": {
    "note": "Separate from character stat gains; returned in API training.performance_gains[]",
    "sim_formula": {
      "expression": "floor((S + F) * 1.15^C + 2*L)",
      "S_wit": 5,
      "S_other": 9,
      "split_pct": [60, 30, 10],
      "calibration_ref": "research/grand_concert_calibration.json",
      "confidence": "community_high"
    }
  },
  "facility_performance_split": {
    "note": "Primary/secondary from GameTora + Condor (Stamina→Vo, Guts→Da). Tertiary is a fixed stand-in for the 10% 'other' bucket.",
    "speed": [
      { "type": "Dance", "pct": 60 },
      { "type": "Visual", "pct": 30 },
      { "type": "Passion", "pct": 10 }
    ],
    "stamina": [
      { "type": "Passion", "pct": 60 },
      { "type": "Vocal", "pct": 30 },
      { "type": "Visual", "pct": 10 }
    ],
    "power": [
      { "type": "Vocal", "pct": 60 },
      { "type": "Composure", "pct": 30 },
      { "type": "Dance", "pct": 10 }
    ],
    "guts": [
      { "type": "Visual", "pct": 60 },
      { "type": "Dance", "pct": 30 },
      { "type": "Passion", "pct": 10 }
    ],
    "wit": [
      { "type": "Composure", "pct": 60 },
      { "type": "Passion", "pct": 30 },
      { "type": "Vocal", "pct": 10 }
    ]
  },

